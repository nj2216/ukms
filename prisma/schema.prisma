generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MembershipRole {
  INSTITUTION_ADMIN
  CAMPUS_MANAGER
  KITCHEN_STAFF
  STOREKEEPER
}

enum StoreType {
  CENTRAL
  CAMPUS
}

enum StockMovementKind {
  RECEIPT
  ISSUE
  WASTE
  ADJUSTMENT
}

model Institution {
  id          String       @id @default(cuid()) @db.VarChar(191)
  name        String       @db.VarChar(191)
  slug        String       @unique @db.VarChar(191)
  timezone    String       @default("UTC") @db.VarChar(64)
  currency    String       @default("USD") @db.Char(3)
  createdAt   DateTime     @default(now())
  campuses    Campus[]
  memberships Membership[]
  ingredients Ingredient[]
  stores      Store[]
  movements   StockMovement[]
  balances    StockBalance[]
  auditEvents AuditEvent[]
}

model BootstrapState {
  key       String   @id @db.VarChar(32)
  createdAt DateTime @default(now())
}

model Campus {
  id            String       @id @default(cuid()) @db.VarChar(191)
  institutionId String       @db.VarChar(191)
  name          String       @db.VarChar(191)
  code          String       @db.VarChar(64)
  timezone      String       @default("UTC") @db.VarChar(64)
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  stores        Store[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId, name])
}

model User {
  id                  String       @id @default(cuid()) @db.VarChar(191)
  email               String       @unique @db.VarChar(191)
  name                String       @db.VarChar(191)
  passwordHash        String       @db.VarChar(255)
  active              Boolean      @default(true)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  memberships         Membership[]
  sessions            Session[]
  auditEvents         AuditEvent[]
}

model Membership {
  id            String          @id @default(cuid()) @db.VarChar(191)
  userId        String          @db.VarChar(191)
  institutionId String          @db.VarChar(191)
  campusId      String?         @db.VarChar(191)
  role          MembershipRole  @default(CAMPUS_MANAGER)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus?          @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Cascade)
  sessions      Session[]

  @@unique([userId, institutionId])
  @@unique([id, userId])
  @@index([institutionId, campusId, role])
}

model Session {
  id           String     @id @default(cuid()) @db.VarChar(191)
  tokenHash    String     @unique @db.Char(64)
  userId       String     @db.VarChar(191)
  membershipId String     @db.VarChar(191)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Ingredient {
  id            String          @id @default(cuid()) @db.VarChar(191)
  institutionId String          @db.VarChar(191)
  name          String          @db.VarChar(191)
  unit          String          @db.VarChar(32)
  reorderLevel  Decimal         @default(0) @db.Decimal(12, 3)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  balances      StockBalance[]
  movements     StockMovement[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@index([institutionId, active, name])
}

model Store {
  id            String          @id @default(cuid()) @db.VarChar(191)
  institutionId String          @db.VarChar(191)
  campusId      String          @db.VarChar(191)
  name          String          @db.VarChar(191)
  type          StoreType       @default(CAMPUS)
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus          @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Cascade)
  balances      StockBalance[]
  movements     StockMovement[]

  @@unique([id, institutionId])
  @@unique([campusId, name])
  @@index([institutionId, campusId])
}

model StockBalance {
  id            String       @id @default(cuid()) @db.VarChar(191)
  institutionId String       @db.VarChar(191)
  storeId       String       @db.VarChar(191)
  ingredientId  String       @db.VarChar(191)
  onHand        Decimal      @default(0) @db.Decimal(12, 3)
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  store         Store        @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient    Ingredient   @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([storeId, ingredientId])
  @@index([institutionId, ingredientId])
}

model StockMovement {
  id            String            @id @default(cuid()) @db.VarChar(191)
  institutionId String            @db.VarChar(191)
  storeId       String            @db.VarChar(191)
  ingredientId  String            @db.VarChar(191)
  kind          StockMovementKind
  quantity      Decimal           @db.Decimal(12, 3)
  note          String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  store         Store             @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  ingredient    Ingredient        @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@index([institutionId, storeId, createdAt])
  @@index([institutionId, ingredientId, createdAt])
}

model AuditEvent {
  id            String       @id @default(cuid()) @db.VarChar(191)
  institutionId String       @db.VarChar(191)
  actorId       String?      @db.VarChar(191)
  action        String       @db.VarChar(100)
  entityType    String       @db.VarChar(100)
  entityId      String       @db.VarChar(191)
  createdAt     DateTime     @default(now())
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([actorId, createdAt])
}
