generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum MembershipRole {
  INSTITUTION_ADMIN
  CAMPUS_MANAGER
  KITCHEN_STAFF
  STOREKEEPER
  PROCUREMENT_OFFICER
  FINANCE_OFFICER
  AUDITOR
}

enum StoreType {
  CENTRAL
  CAMPUS
}

enum StockMovementKind {
  RECEIPT
  ISSUE
  WASTE
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum MenuPlanStatus {
  DRAFT
  PUBLISHED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
}

enum WasteCategory {
  RAW_INGREDIENT
  PREPARED_MEAL
  LEFTOVER
  SPOILAGE
}

enum SupplierQuoteStatus {
  SUBMITTED
  AWARDED
  REJECTED
}

enum SupplierInvoiceStatus {
  PENDING
  RECONCILED
  REJECTED
}

model Institution {
  id               String            @id @default(cuid()) @db.VarChar(191)
  name             String            @db.VarChar(191)
  slug             String            @unique @db.VarChar(191)
  timezone         String            @default("UTC") @db.VarChar(64)
  currency         String            @default("USD") @db.Char(3)
  createdAt        DateTime          @default(now())
  campuses         Campus[]
  memberships      Membership[]
  ingredients      Ingredient[]
  stores           Store[]
  movements        StockMovement[]
  balances         StockBalance[]
  batches          StockBatch[]
  recipes          Recipe[]
  menuPlans        MenuPlan[]
  suppliers        Supplier[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  productionRuns   ProductionRun[]
  wasteRecords     WasteRecord[]
  stockTransfers   StockTransfer[]
  financialBudgets FinancialBudget[]
  supplierQuotes   SupplierQuote[]
  supplierInvoices SupplierInvoice[]
  auditEvents      AuditEvent[]
}

model BootstrapState {
  key       String   @id @db.VarChar(32)
  createdAt DateTime @default(now())
}

model Campus {
  id               String            @id @default(cuid()) @db.VarChar(191)
  institutionId    String            @db.VarChar(191)
  name             String            @db.VarChar(191)
  code             String            @db.VarChar(64)
  timezone         String            @default("UTC") @db.VarChar(64)
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  memberships      Membership[]
  stores           Store[]
  menuPlans        MenuPlan[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  productionRuns   ProductionRun[]
  wasteRecords     WasteRecord[]
  transfersFrom    StockTransfer[]   @relation("TransferOriginCampus")
  transfersTo      StockTransfer[]   @relation("TransferDestinationCampus")
  financialBudgets FinancialBudget[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId, name])
}

model User {
  id                  String       @id @default(cuid()) @db.VarChar(191)
  email               String       @unique @db.VarChar(191)
  name                String       @db.VarChar(191)
  passwordHash        String       @db.VarChar(255)
  active              Boolean      @default(true)
  mustChangePassword  Boolean      @default(false)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime     @default(now())
  memberships         Membership[]
  sessions            Session[]
  auditEvents         AuditEvent[]
}

model Membership {
  id            String         @id @default(cuid()) @db.VarChar(191)
  userId        String         @db.VarChar(191)
  institutionId String         @db.VarChar(191)
  campusId      String?        @db.VarChar(191)
  role          MembershipRole @default(CAMPUS_MANAGER)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus?        @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Cascade)
  sessions      Session[]

  @@unique([userId, institutionId])
  @@unique([id, userId])
  @@index([institutionId, campusId, role])
}

model Session {
  id           String     @id @default(cuid()) @db.VarChar(191)
  tokenHash    String     @unique @db.Char(64)
  userId       String     @db.VarChar(191)
  membershipId String     @db.VarChar(191)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Ingredient {
  id                   String                @id @default(cuid()) @db.VarChar(191)
  institutionId        String                @db.VarChar(191)
  name                 String                @db.VarChar(191)
  unit                 String                @db.VarChar(32)
  reorderLevel         Decimal               @default(0) @db.Decimal(12, 3)
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  institution          Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  balances             StockBalance[]
  movements            StockMovement[]
  batches              StockBatch[]
  recipeIngredients    RecipeIngredient[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  productionIssues     ProductionIssue[]
  wasteRecords         WasteRecord[]
  transferItems        StockTransferItem[]
  supplierQuoteItems   SupplierQuoteItem[]

  @@unique([institutionId, name])
  @@unique([id, institutionId])
  @@index([institutionId, active, name])
}

model Store {
  id               String            @id @default(cuid()) @db.VarChar(191)
  institutionId    String            @db.VarChar(191)
  campusId         String            @db.VarChar(191)
  name             String            @db.VarChar(191)
  type             StoreType         @default(CAMPUS)
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus           Campus            @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Cascade)
  balances         StockBalance[]
  movements        StockMovement[]
  batches          StockBatch[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  wasteRecords     WasteRecord[]
  transfersFrom    StockTransfer[]   @relation("TransferOriginStore")
  transfersTo      StockTransfer[]   @relation("TransferDestinationStore")
  productionRuns   ProductionRun[]

  @@unique([id, institutionId])
  @@unique([campusId, name])
  @@index([institutionId, campusId])
}

model StockBalance {
  id            String      @id @default(cuid()) @db.VarChar(191)
  institutionId String      @db.VarChar(191)
  storeId       String      @db.VarChar(191)
  ingredientId  String      @db.VarChar(191)
  onHand        Decimal     @default(0) @db.Decimal(12, 3)
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  store         Store       @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient    Ingredient  @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Cascade)

  @@unique([storeId, ingredientId])
  @@index([institutionId, ingredientId])
}

model StockBatch {
  id                String          @id @default(cuid()) @db.VarChar(191)
  institutionId     String          @db.VarChar(191)
  storeId           String          @db.VarChar(191)
  ingredientId      String          @db.VarChar(191)
  batchCode         String          @db.VarChar(100)
  expiryDate        DateTime?       @db.Date
  receivedQuantity  Decimal         @db.Decimal(12, 3)
  remainingQuantity Decimal         @db.Decimal(12, 3)
  unitCost          Decimal?        @db.Decimal(12, 4)
  receivedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  institution       Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  store             Store           @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient        Ingredient      @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)
  movements         StockMovement[]

  @@unique([id, institutionId])
  @@index([institutionId, storeId, ingredientId, expiryDate])
  @@index([institutionId, expiryDate, remainingQuantity])
}

model StockMovement {
  id            String            @id @default(cuid()) @db.VarChar(191)
  institutionId String            @db.VarChar(191)
  storeId       String            @db.VarChar(191)
  ingredientId  String            @db.VarChar(191)
  batchId       String?           @db.VarChar(191)
  kind          StockMovementKind
  quantity      Decimal           @db.Decimal(12, 3)
  note          String?           @db.VarChar(500)
  createdAt     DateTime          @default(now())
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  store         Store             @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  ingredient    Ingredient        @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)
  batch         StockBatch?       @relation(fields: [batchId, institutionId], references: [id, institutionId], onDelete: Restrict)
  transferId    String?           @db.VarChar(191)
  transfer      StockTransfer?    @relation(fields: [transferId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@index([institutionId, storeId, createdAt])
  @@index([institutionId, ingredientId, createdAt])
  @@index([batchId, institutionId])
  @@index([transferId, institutionId])
}

model Recipe {
  id            String          @id @default(cuid()) @db.VarChar(191)
  institutionId String          @db.VarChar(191)
  name          String          @db.VarChar(191)
  description   String?         @db.VarChar(500)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  institution   Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  versions      RecipeVersion[]

  @@unique([id, institutionId])
  @@unique([institutionId, name])
  @@index([institutionId, active, name])
}

model RecipeVersion {
  id            String             @id @default(cuid()) @db.VarChar(191)
  institutionId String             @db.VarChar(191)
  recipeId      String             @db.VarChar(191)
  versionNumber Int
  servingYield  Int
  createdAt     DateTime           @default(now())
  recipe        Recipe             @relation(fields: [recipeId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredients   RecipeIngredient[]
  menuItems     MenuPlanItem[]

  @@unique([id, institutionId])
  @@unique([recipeId, versionNumber])
  @@index([institutionId, recipeId, versionNumber])
}

model RecipeIngredient {
  id              String        @id @default(cuid()) @db.VarChar(191)
  institutionId   String        @db.VarChar(191)
  recipeVersionId String        @db.VarChar(191)
  ingredientId    String        @db.VarChar(191)
  quantity        Decimal       @db.Decimal(12, 3)
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([recipeVersionId, ingredientId])
  @@index([institutionId, ingredientId])
}

model MenuPlan {
  id             String          @id @default(cuid()) @db.VarChar(191)
  institutionId  String          @db.VarChar(191)
  campusId       String          @db.VarChar(191)
  name           String          @db.VarChar(191)
  mealType       MealType
  serviceDate    DateTime        @db.Date
  status         MenuPlanStatus  @default(DRAFT)
  createdAt      DateTime        @default(now())
  institution    Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus         Campus          @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Cascade)
  items          MenuPlanItem[]
  productionRuns ProductionRun[]

  @@unique([id, institutionId])
  @@index([institutionId, campusId, serviceDate])
}

model MenuPlanItem {
  id              String        @id @default(cuid()) @db.VarChar(191)
  institutionId   String        @db.VarChar(191)
  menuPlanId      String        @db.VarChar(191)
  recipeVersionId String        @db.VarChar(191)
  plannedServings Int
  menuPlan        MenuPlan      @relation(fields: [menuPlanId, institutionId], references: [id, institutionId], onDelete: Cascade)
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([menuPlanId, recipeVersionId])
  @@index([institutionId, recipeVersionId])
}

model Supplier {
  id               String            @id @default(cuid()) @db.VarChar(191)
  institutionId    String            @db.VarChar(191)
  name             String            @db.VarChar(191)
  email            String?           @db.VarChar(191)
  phone            String?           @db.VarChar(64)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  supplierQuotes   SupplierQuote[]

  @@unique([id, institutionId])
  @@unique([institutionId, name])
  @@index([institutionId, active, name])
}

model PurchaseRequest {
  id             String                @id @default(cuid()) @db.VarChar(191)
  institutionId  String                @db.VarChar(191)
  campusId       String                @db.VarChar(191)
  storeId        String                @db.VarChar(191)
  supplierId     String                @db.VarChar(191)
  status         PurchaseRequestStatus @default(DRAFT)
  note           String?               @db.VarChar(500)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  institution    Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus         Campus                @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  store          Store                 @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  supplier       Supplier              @relation(fields: [supplierId, institutionId], references: [id, institutionId], onDelete: Restrict)
  items          PurchaseRequestItem[]
  purchaseOrder  PurchaseOrder?
  supplierQuotes SupplierQuote[]

  @@unique([id, institutionId])
  @@index([institutionId, campusId, status, createdAt])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid()) @db.VarChar(191)
  institutionId     String          @db.VarChar(191)
  purchaseRequestId String          @db.VarChar(191)
  ingredientId      String          @db.VarChar(191)
  quantity          Decimal         @db.Decimal(12, 3)
  estimatedUnitCost Decimal?        @db.Decimal(12, 4)
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient        Ingredient      @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([purchaseRequestId, ingredientId])
  @@index([institutionId, ingredientId])
}

model PurchaseOrder {
  id                String              @id @default(cuid()) @db.VarChar(191)
  institutionId     String              @db.VarChar(191)
  purchaseRequestId String              @db.VarChar(191)
  supplierQuoteId   String?             @db.VarChar(191)
  campusId          String              @db.VarChar(191)
  storeId           String              @db.VarChar(191)
  supplierId        String              @db.VarChar(191)
  status            PurchaseOrderStatus @default(OPEN)
  createdAt         DateTime            @default(now())
  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  purchaseRequest   PurchaseRequest     @relation(fields: [purchaseRequestId, institutionId], references: [id, institutionId], onDelete: Restrict)
  campus            Campus              @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  store             Store               @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  supplier          Supplier            @relation(fields: [supplierId, institutionId], references: [id, institutionId], onDelete: Restrict)
  supplierQuote     SupplierQuote?      @relation(fields: [supplierQuoteId, institutionId], references: [id, institutionId], onDelete: Restrict)
  items             PurchaseOrderItem[]
  receipts          PurchaseReceipt[]
  invoices          SupplierInvoice[]

  @@unique([id, institutionId])
  @@unique([purchaseRequestId, institutionId])
  @@unique([supplierQuoteId, institutionId])
  @@index([institutionId, campusId, status, createdAt])
}

model PurchaseOrderItem {
  id               String                @id @default(cuid()) @db.VarChar(191)
  institutionId    String                @db.VarChar(191)
  purchaseOrderId  String                @db.VarChar(191)
  ingredientId     String                @db.VarChar(191)
  orderedQuantity  Decimal               @db.Decimal(12, 3)
  receivedQuantity Decimal               @default(0) @db.Decimal(12, 3)
  unitCost         Decimal?              @db.Decimal(12, 4)
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient       Ingredient            @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)
  receiptItems     PurchaseReceiptItem[]

  @@unique([id, institutionId])
  @@unique([purchaseOrderId, ingredientId])
  @@index([institutionId, ingredientId])
}

model PurchaseReceipt {
  id              String                @id @default(cuid()) @db.VarChar(191)
  institutionId   String                @db.VarChar(191)
  campusId        String                @db.VarChar(191)
  storeId         String                @db.VarChar(191)
  purchaseOrderId String                @db.VarChar(191)
  idempotencyKey  String?               @db.VarChar(128)
  receivedAt      DateTime              @default(now())
  note            String?               @db.VarChar(500)
  institution     Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus          Campus                @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  store           Store                 @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId, institutionId], references: [id, institutionId], onDelete: Restrict)
  items           PurchaseReceiptItem[]

  @@unique([id, institutionId])
  @@unique([institutionId, idempotencyKey])
  @@index([institutionId, purchaseOrderId, receivedAt])
}

model PurchaseReceiptItem {
  id                  String            @id @default(cuid()) @db.VarChar(191)
  institutionId       String            @db.VarChar(191)
  purchaseReceiptId   String            @db.VarChar(191)
  purchaseOrderItemId String            @db.VarChar(191)
  quantity            Decimal           @db.Decimal(12, 3)
  batchCode           String?           @db.VarChar(100)
  expiryDate          DateTime?         @db.Date
  purchaseReceipt     PurchaseReceipt   @relation(fields: [purchaseReceiptId, institutionId], references: [id, institutionId], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@index([institutionId, purchaseReceiptId])
  @@index([purchaseOrderItemId])
}

model SupplierQuote {
  id                String              @id @default(cuid()) @db.VarChar(191)
  institutionId     String              @db.VarChar(191)
  purchaseRequestId String              @db.VarChar(191)
  supplierId        String              @db.VarChar(191)
  status            SupplierQuoteStatus @default(SUBMITTED)
  validUntil        DateTime?           @db.Date
  note              String?             @db.VarChar(500)
  createdAt         DateTime            @default(now())
  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  purchaseRequest   PurchaseRequest     @relation(fields: [purchaseRequestId, institutionId], references: [id, institutionId], onDelete: Cascade)
  supplier          Supplier            @relation(fields: [supplierId, institutionId], references: [id, institutionId], onDelete: Restrict)
  items             SupplierQuoteItem[]
  purchaseOrder     PurchaseOrder?

  @@unique([id, institutionId])
  @@index([institutionId, purchaseRequestId, status])
}

model SupplierQuoteItem {
  id              String        @id @default(cuid()) @db.VarChar(191)
  institutionId   String        @db.VarChar(191)
  supplierQuoteId String        @db.VarChar(191)
  ingredientId    String        @db.VarChar(191)
  quantity        Decimal       @db.Decimal(12, 3)
  unitCost        Decimal       @db.Decimal(12, 4)
  supplierQuote   SupplierQuote @relation(fields: [supplierQuoteId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([supplierQuoteId, ingredientId])
  @@index([institutionId, ingredientId])
}

model SupplierInvoice {
  id                    String                @id @default(cuid()) @db.VarChar(191)
  institutionId         String                @db.VarChar(191)
  purchaseOrderId       String                @db.VarChar(191)
  supplierInvoiceNumber String                @db.VarChar(100)
  invoiceDate           DateTime              @db.Date
  amount                Decimal               @db.Decimal(14, 2)
  status                SupplierInvoiceStatus @default(PENDING)
  note                  String?               @db.VarChar(500)
  createdAt             DateTime              @default(now())
  reconciledAt          DateTime?
  institution           Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  purchaseOrder         PurchaseOrder         @relation(fields: [purchaseOrderId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([id, institutionId])
  @@unique([purchaseOrderId, institutionId])
  @@unique([institutionId, supplierInvoiceNumber])
  @@index([institutionId, status, invoiceDate])
}

model ProductionRun {
  id               String            @id @default(cuid()) @db.VarChar(191)
  institutionId    String            @db.VarChar(191)
  campusId         String            @db.VarChar(191)
  storeId          String            @db.VarChar(191)
  menuPlanId       String?           @db.VarChar(191)
  name             String            @db.VarChar(191)
  preparedServings Int
  servedServings   Int
  leftoverServings Int
  totalCost        Decimal?          @db.Decimal(14, 4)
  note             String?           @db.VarChar(500)
  createdAt        DateTime          @default(now())
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus           Campus            @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  store            Store             @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  menuPlan         MenuPlan?         @relation(fields: [menuPlanId, institutionId], references: [id, institutionId], onDelete: Restrict)
  issues           ProductionIssue[]
  wasteRecords     WasteRecord[]

  @@unique([id, institutionId])
  @@index([institutionId, campusId, createdAt])
  @@index([institutionId, menuPlanId])
}

model ProductionIssue {
  id              String        @id @default(cuid()) @db.VarChar(191)
  institutionId   String        @db.VarChar(191)
  productionRunId String        @db.VarChar(191)
  ingredientId    String        @db.VarChar(191)
  quantity        Decimal       @db.Decimal(12, 3)
  unitCost        Decimal?      @db.Decimal(12, 4)
  productionRun   ProductionRun @relation(fields: [productionRunId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@index([institutionId, productionRunId])
  @@index([institutionId, ingredientId])
}

model WasteRecord {
  id              String         @id @default(cuid()) @db.VarChar(191)
  institutionId   String         @db.VarChar(191)
  campusId        String         @db.VarChar(191)
  storeId         String?        @db.VarChar(191)
  productionRunId String?        @db.VarChar(191)
  ingredientId    String?        @db.VarChar(191)
  category        WasteCategory
  quantity        Decimal        @db.Decimal(12, 3)
  unit            String         @db.VarChar(32)
  estimatedCost   Decimal?       @db.Decimal(14, 4)
  reason          String         @db.VarChar(500)
  createdAt       DateTime       @default(now())
  institution     Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus          Campus         @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  store           Store?         @relation(fields: [storeId, institutionId], references: [id, institutionId], onDelete: Restrict)
  productionRun   ProductionRun? @relation(fields: [productionRunId, institutionId], references: [id, institutionId], onDelete: Restrict)
  ingredient      Ingredient?    @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([id, institutionId])
  @@index([institutionId, campusId, createdAt])
  @@index([institutionId, category, createdAt])
}

model StockTransfer {
  id                  String              @id @default(cuid()) @db.VarChar(191)
  institutionId       String              @db.VarChar(191)
  originCampusId      String              @db.VarChar(191)
  destinationCampusId String              @db.VarChar(191)
  originStoreId       String              @db.VarChar(191)
  destinationStoreId  String              @db.VarChar(191)
  note                String?             @db.VarChar(500)
  createdAt           DateTime            @default(now())
  institution         Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  originCampus        Campus              @relation("TransferOriginCampus", fields: [originCampusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  destinationCampus   Campus              @relation("TransferDestinationCampus", fields: [destinationCampusId, institutionId], references: [id, institutionId], onDelete: Restrict)
  originStore         Store               @relation("TransferOriginStore", fields: [originStoreId, institutionId], references: [id, institutionId], onDelete: Restrict)
  destinationStore    Store               @relation("TransferDestinationStore", fields: [destinationStoreId, institutionId], references: [id, institutionId], onDelete: Restrict)
  items               StockTransferItem[]
  movements           StockMovement[]

  @@unique([id, institutionId])
  @@index([institutionId, createdAt])
  @@index([institutionId, originCampusId, createdAt])
  @@index([institutionId, destinationCampusId, createdAt])
}

model StockTransferItem {
  id              String        @id @default(cuid()) @db.VarChar(191)
  institutionId   String        @db.VarChar(191)
  stockTransferId String        @db.VarChar(191)
  ingredientId    String        @db.VarChar(191)
  quantity        Decimal       @db.Decimal(12, 3)
  stockTransfer   StockTransfer @relation(fields: [stockTransferId, institutionId], references: [id, institutionId], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([stockTransferId, ingredientId])
  @@index([institutionId, ingredientId])
}

model FinancialBudget {
  id            String      @id @default(cuid()) @db.VarChar(191)
  institutionId String      @db.VarChar(191)
  campusId      String?     @db.VarChar(191)
  name          String      @db.VarChar(191)
  periodStart   DateTime    @db.Date
  periodEnd     DateTime    @db.Date
  amount        Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus?     @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([id, institutionId])
  @@index([institutionId, campusId, periodStart, periodEnd])
}

model AuditEvent {
  id            String      @id @default(cuid()) @db.VarChar(191)
  institutionId String      @db.VarChar(191)
  actorId       String?     @db.VarChar(191)
  action        String      @db.VarChar(100)
  entityType    String      @db.VarChar(100)
  entityId      String      @db.VarChar(191)
  createdAt     DateTime    @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  actor         User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([institutionId, createdAt])
  @@index([actorId, createdAt])
}
